# Cogniva backend environment (copy to .env or export in your shell)

# --- Database (REQUIRED) ---------------------------------------------------
# All storage is Postgres: workspaces, sessions, checkpoints, chat, transcripts
# and the debrief report. The backend refuses to start without this.
#
# Using docker compose? It sets this for you and you can leave it blank here.
# Running the backend directly? Point it at your own Postgres, then:
#
#   npm run db:migrate     # create/update the tables
#   npm run db:generate    # build the Prisma client (also run by `npm install`)
#
DATABASE_URL=postgresql://cogniva:cogniva@localhost:5432/cogniva?schema=public

# --- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-in-dev

# Gemini API key — required for the real Learner agent (M1+).
# Without it, the backend still runs end to end using a deterministic fallback
# Learner, so the skeleton works for teammates who haven't set a key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Learner model. Defaults to a fast model; set to a higher-quality model
# (e.g. gemini-2.5-pro) for richer responses if you prefer.
COGNIVA_LEARNER_MODEL=gemini-2.5-flash

# Optional tuning
# COGNIVA_LLM_MAX_TOKENS=2048
# COGNIVA_LLM_TIMEOUT=60
# COGNIVA_LLM_THINKING_BUDGET=0          # 0 disables model "thinking" (faster, reliable JSON)
# COGNIVA_VISION_CONFIDENCE_THRESHOLD=0.6

# --- Planner (the Orchestrator's brain) -----------------------------------
# The Planner decides which agents run each turn instead of always running
# Vision -> ASR -> Learner: an unchanged board skips Vision, a turn with no clip
# skips ASR, an unsure board reading gets a second directed look. Without an API
# key it falls back to the same decisions made by deterministic rules.
# COGNIVA_PLANNER_MODEL=gemini-2.5-flash
# COGNIVA_PLANNER_MODE=auto              # "rules" = never call the model to plan
# COGNIVA_PLANNER_MAX_STEPS=5            # step budget per teaching turn
# COGNIVA_PLANNER_MAX_REPLANS=1          # re-plans allowed when a step surprises it
# COGNIVA_PLANNER_MAX_TOKENS=512

# --- Retrieval / RAG for the Evaluator ------------------------------------
# The uploaded PDF is chunked and embedded once, then only the passages relevant
# to what the user taught are sent to the Evaluator. Without an API key the
# index still works, using keyword (TF-IDF) search instead of embeddings.
# COGNIVA_EMBEDDING_MODEL=gemini-embedding-001
# COGNIVA_EMBEDDING_DIMENSIONS=768       # native size is 3072; smaller = lighter index
# COGNIVA_RAG_CHUNK_SIZE=900             # characters per chunk
# COGNIVA_RAG_CHUNK_OVERLAP=150
# COGNIVA_RAG_TOP_K=3                    # chunks retrieved per query
# COGNIVA_RAG_MAX_CHUNKS=8               # cap on the merged excerpt set
# COGNIVA_RAG_KEYWORD_WEIGHT=0.3         # keyword share when blending with vectors

# --- Referencer (finds reading material when the user has none) ------------
# Runs on request, not per turn, and only from the "Find reference" dialog.
# With no API key it still works: the option list falls back to open-library
# entry points, and a chosen source is downloaded by the server directly.
# COGNIVA_REFERENCER_MODEL=gemini-2.5-flash
# COGNIVA_REFERENCER_OPTIONS=4           # how many options the user is offered
# COGNIVA_REFERENCER_MAX_TOKENS=2048     # search + shaping passes
# COGNIVA_REFERENCER_READ_MAX_TOKENS=16384   # notes written from a chosen page
# COGNIVA_REFERENCER_MAX_FETCH_CHARS=60000   # cap on text taken from one source

# --- Learner voice (XTTS v2, services/tts) --------------------------------
# Off by default. The voice service is a separate Python process that has to be
# started deliberately; without it the app simply stays silent.
# Setup: services/tts/README.md  (needs Python 3.10-3.12, NOT 3.13)
# NOTE: XTTS v2 is licensed for non-commercial use only (CPML).
# COGNIVA_TTS_ENABLED=true
# COGNIVA_TTS_URL=http://localhost:8020
# COGNIVA_TTS_LANGUAGE=en                # XTTS v2 does not support Indonesian
# COGNIVA_TTS_TIMEOUT=45

# Force the deterministic mock Learner (no Gemini call) — handy for offline work.
# USE_MOCK_AI=false

# Server port (frontend expects 8000 by default)
# PORT=8000

# Swap Postgres for the in-memory store doubles. This is how the test suite runs
# (vitest sets it); do NOT set it for a real server — nothing would survive a
# restart. Left unset, a missing DATABASE_URL is a startup error rather than a
# silent downgrade to volatile storage.
# COGNIVA_STORE=memory
