# Cogniva — environment for `docker compose up`.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Compose reads this file automatically. The backend's own defaults live in
# apps/backend/.env.example and are only used when you run it outside Docker.

# --- Database --------------------------------------------------------------
# Compose builds DATABASE_URL from these and hands it to the backend, so there
# is nothing else to set. Change the password before deploying anywhere real.
POSTGRES_USER=cogniva
POSTGRES_PASSWORD=cogniva
POSTGRES_DB=cogniva

# --- Model -----------------------------------------------------------------
# Optional: without a key the Learner, Vision and Evaluator fall back to
# deterministic mocks and the app still runs end to end.
GEMINI_API_KEY=
COGNIVA_LEARNER_MODEL=gemini-2.5-flash

# --- Learner voice ---------------------------------------------------------
# Both halves are needed: the service only starts with the "voice" profile
# (docker compose --profile voice up -d --build), and the backend only calls it
# when this is true. Left as-is, the learner replies in text and nothing breaks.
COGNIVA_TTS_ENABLED=false
# "chatterbox-turbo" (default) is the fastest and the one the app is tuned around;
# "chatterbox" is slower but honours the per-voice delivery tuning in voices.json.
TTS_ENGINE=chatterbox-turbo
# "cpu" or "cuda". The compose service has no GPU passthrough configured, so cpu
# is the only value that works here -- expect 10-30s per reply. For GPU speed,
# run the service outside Docker (see services/tts/README.md).
TTS_DEVICE=cpu
TTS_DEFAULT_LANGUAGE=en
